{
  "uid": "penvire-service",
  "title": "Service",
  "description": "One service: HTTP traffic, JVM, logs and traces.",
  "tags": ["penvire"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(target_info, job)",
        "query": { "query": "label_values(target_info, job)", "refId": "service" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$service\"}[$__rate_interval])) or vector(0)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server errors (5xx)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"$service\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$service\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Heap used",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"$service\",jvm_memory_type=\"heap\"})" }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by route and status",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (http_request_method, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$service\"}[$__rate_interval]))", "legendFormat": "{{http_request_method}} {{http_route}} {{http_response_status_code}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$service\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$service\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$service\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (jvm_memory_type) (jvm_memory_used_bytes{job=\"$service\"})", "legendFormat": "{{jvm_memory_type}} used" },
        { "refId": "B", "expr": "sum(jvm_memory_committed_bytes{job=\"$service\",jvm_memory_type=\"heap\"})", "legendFormat": "heap committed" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GC time",
      "gridPos": { "x": 6, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (jvm_gc_name) (rate(jvm_gc_duration_seconds_sum{job=\"$service\"}[$__rate_interval]))", "legendFormat": "{{jvm_gc_name}}" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_cpu_recent_utilization_ratio{job=\"$service\"})", "legendFormat": "JVM CPU" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Threads",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (jvm_thread_state) (jvm_thread_count{job=\"$service\"})", "legendFormat": "{{jvm_thread_state}}" }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Logs and traces",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"$service\"}" }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Recent traces",
      "description": "Click a trace ID to open it in Tempo.",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 9 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"$service\"}", "limit": 20, "tableType": "traces" }
      ]
    }
  ]
}
