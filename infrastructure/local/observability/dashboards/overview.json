{
  "uid": "penvire-overview",
  "title": "Overview",
  "description": "All services at a glance. Click a service to open its dashboard.",
  "tags": ["penvire"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Services",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "version", "expr": "count by (job, service_version) (target_info)", "instant": true, "format": "table" },
        { "refId": "rps", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[5m]))", "instant": true, "format": "table" },
        { "refId": "errors", "expr": "(sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) or (sum by (job) (rate(http_server_request_duration_seconds_count[5m])) * 0)) / sum by (job) (rate(http_server_request_duration_seconds_count[5m]))", "instant": true, "format": "table" },
        { "refId": "p95", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[5m])))", "instant": true, "format": "table" },
        { "refId": "heap", "expr": "sum by (job) (jvm_memory_used_bytes{jvm_memory_type=\"heap\"})", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "job", "mode": "outer" } },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Value #version": true },
            "renameByName": { "job": "Service", "service_version": "Version", "Value #rps": "Requests / s", "Value #errors": "5xx", "Value #p95": "p95", "Value #heap": "Heap used" },
            "indexByName": { "job": 0, "service_version": 1, "Value #rps": 2, "Value #errors": 3, "Value #p95": 4, "Value #heap": 5 }
        } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Service" }, "properties": [ { "id": "links", "value": [ { "title": "Open service dashboard", "url": "/d/penvire-service?var-service=${__value.raw}" } ] } ] },
          { "matcher": { "id": "byName", "options": "Requests / s" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 1 } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 } ] },
          { "matcher": { "id": "byName", "options": "Heap used" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s by service",
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by service",
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx responses / s by service",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or (sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval])) * 0)", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log lines by service and level",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\".+\"}[$__auto]))", "legendFormat": "{{service_name}} {{detected_level}}" }
      ]
    }
  ]
}
